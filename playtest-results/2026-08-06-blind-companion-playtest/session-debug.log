livered too.","input_schema":{"type":"object","properties":{"resource":{"type":"string","description":"Resource to acquire if needed and deliver, including one already held."},"count":{"type":"integer","minimum":1.0,"maximum":2304.0,"description":"How many to end up holding."}},"required":["resource"]}},{"name":"smelt","description":"Smelt an input item in a furnace until holding the output.","input_schema":{"type":"object","properties":{"item":{"type":"string","description":"Input item id to smelt, e.g. 'cobblestone'."},"count":{"type":"integer","minimum":1.0,"maximum":2304.0,"description":"How many to end up holding."}},"required":["item"]}},{"name":"kill","description":"Attack a specific entity until it dies.","input_schema":{"type":"object","properties":{"target":{"type":"string","description":"UUID of the entity to attack."}},"required":["target"]}},{"name":"come_to_owner","description":"Walk to the owner's current position, tracking them if they move, and finish once within the given distance. Use this whenever the owner asks the companion to come to them; it completes on arrival.","input_schema":{"type":"object","properties":{"distance":{"type":"number","minimum":1.0,"maximum":32.0,"description":"How close counts as arrived, in blocks."}},"required":[]}},{"name":"withdraw","description":"Take items out of a specific container.","input_schema":{"type":"object","properties":{"container":{"type":"array","items":{"type":"integer"},"minItems":3,"maxItems":3,"description":"Container position as [x, y, z]."},"item":{"type":"string","description":"Item id to withdraw."},"count":{"type":"integer","minimum":1.0,"maximum":2304.0,"description":"How many to end up holding."}},"required":["container","item"]}},{"name":"fetch_items","description":"Deliver a set of final items to the owner in one order: each item is acquired or crafted if needed, then delivered in sequence; an item that proves unavailable is skipped and reported at the end.","input_schema":{"type":"object","